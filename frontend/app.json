{
  "expo": {
    "name": "Infantia",
    "slug": "infantia",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "infantia",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "extra": {
      "eas": {
        "projectId": "infantia"
      }
    }
  }
}